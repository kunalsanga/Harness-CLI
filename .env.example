# Harness Engineering CLI — Environment Variables
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control.

# OpenRouter (multi-model gateway — primary provider)
OPENROUTER_API_KEY=

# LiteLLM (unified provider abstraction)
LITELLM_API_KEY=
LITELLM_API_BASE=

# Ollama (local inference — no key needed, just ensure Ollama is running)
OLLAMA_HOST=http://localhost:11434
