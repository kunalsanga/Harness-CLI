# Harness Engineering CLI — Environment Configuration
# Copy this file to .env and configure your desired AI providers.
# NEVER commit your real .env file or API keys to version control.

# ==============================================================================
# 1. CORE AI PROVIDERS (Multi-Provider Support)
# ==============================================================================

# A. OpenRouter (Multi-model gateway with free & paid tiers)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free

# B. OpenAI (Direct OpenAI API)
# Note: ChatGPT Plus/Team subscriptions do NOT provide API credits. An active API billing balance is required.
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# C. NVIDIA NIM (NVIDIA Inference Microservices)
# Obtain an API key from https://build.nvidia.com
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# D. FreeLLMAPI (OpenAI-compatible local/remote gateway)
FREELLMAPI_API_KEY=your_freellmapi_api_key_or_empty
# FREELLMAPI_BASE_URL=http://localhost:31415/v1
# FREELLMAPI_MODEL=auto

# E. Groq (High-speed LPU inference)
# Obtain an API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# F. Azure OpenAI Service
# AZURE_OPENAI_API_KEY=your_azure_api_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ==============================================================================
# 2. PROVIDER PRIORITY & AUTOMATIC FAILOVER
# ==============================================================================
# Comma-separated list defining provider failover order.
# If primary hits a rate limit, credits exhausted, or outage, Harness automatically
# fails over to the next configured provider while preserving session & conversation state.
# HARNESS_PROVIDER_PRIORITY=openrouter,nvidia,groq,freellmapi,azure,openai

# Maximum models to include in the active fallback chain (default: 5)
# HARNESS_MAX_FALLBACK_CHAIN=5

# ==============================================================================
# 3. TIMEOUTS, RETRIES & HEALTH CHECKS
# ==============================================================================
# Per-model attempt timeout in seconds (default: 90.0)
# HARNESS_MODEL_TIMEOUT=90.0

# Total timeout across all fallback attempts in seconds (default: 120.0)
# HARNESS_TOTAL_TIMEOUT=120.0

# Maximum retry attempts on transient network / 5xx server errors (default: 2)
# HARNESS_MAX_RETRIES=2

# Health check probe timeout in seconds (default: 5.0)
# HARNESS_HEALTH_TIMEOUT=5.0

# ==============================================================================
# 4. TOKEN BUDGETS & COST CONTROLS
# ==============================================================================
# Maximum iterations per task run (default: 30)
# HARNESS_MAX_ITERATIONS=30

# Maximum estimated dollar cost allowed per task run (optional)
# HARNESS_MAX_COST_PER_TASK=5.00

# Strict free mode (hard constraint: never route to paid endpoints)
# HARNESS_FREE_MODE=false
